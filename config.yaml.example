# SuisuiCode 配置示例
# 复制此文件到 ~/.suisuicode/config.yaml 并填入真实值

providers:
  - name: claude
    protocol: anthropic
    model: claude-opus-4-5
    base_url: https://api.anthropic.com
    api_key: sk-ant-your-key-here
    thinking: false

